<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- Mascot Image (Mr. Oyen) -->
    <ImageView
        android:id="@+id/widget_oyen_image"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:src="@drawable/lazyass_oyen"
        android:contentDescription="Mr. Oyen" />

    <!-- Content Area (Right of Oyen) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_oyen_image"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <!-- Title / Status Text -->
        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pawcket - Logging Expense"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:alpha="0.8" />

        <!-- Subtitle or User Input Preview -->
        <TextView
            android:id="@+id/widget_input_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to log: 'Makan sate 25k'"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Action Buttons Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <!-- Button: Open App/Input (Simulates text input launcher) -->
            <TextView
                android:id="@+id/btn_widget_input"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/button_widget_background"
                android:gravity="center"
                android:text="✍️ Type Expense"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Button: Voice Input -->
            <ImageView
                android:id="@+id/btn_widget_mic"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_widget_round_background"
                android:padding="6dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Voice Input" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
